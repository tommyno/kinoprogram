---
import { Font } from 'astro:assets';
import '@styles/global.css';
import { BUILD_ID } from '@lib/build.ts';
import styles from './Base.module.css';

type Props = {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Added to the page's <main>. */
  class?: string;
};

const SITE_NAME = 'Kinoprogram for Oslo';

const {
  title,
  description = 'Alle kinoer, filmklubber og filmer i Oslo på ett sted.',
  noindex = false,
  class: className,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- First in the head, so a page that sends the visitor on does it before anything loads -->
    <slot name="head" />
    <!-- Inline in the head, so it is set before the page first renders -->
    <script is:inline>
      // Back and forward open the page as it was left, without the items fading in again (see data-stagger)
      if (performance.getEntriesByType('navigation')[0]?.type === 'back_forward') document.documentElement.toggleAttribute('data-returned', true);
    </script>
    <Font cssVariable="--font-inter" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Kinoprogram" />
    <meta name="build" content={BUILD_ID} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main class:list={[styles.page, className]}>
      <slot />
    </main>
  </body>
</html>

<script>
  import { programNow } from '@lib/time.ts';

  const build = document.querySelector<HTMLMetaElement>('meta[name="build"]')?.content;
  const loadedOn = programNow().day;

  // An installed app resumes without reloading; when it comes back into view on a new day, or with a newer build out, reload
  document.addEventListener('visibilitychange', async () => {
    if (document.visibilityState !== 'visible') return;
    if (programNow().day !== loadedOn) return location.reload();
    try {
      const response = await fetch('/version.txt', { cache: 'no-store' });
      if (response.ok && (await response.text()) !== build) location.reload();
    } catch {}
  });

  // A back link (data-back), coming from the program, goes back in history instead, so it opens at the same date, sort and scroll position
  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (event) => {
    const fromProgram = document.referrer.startsWith(location.origin) && history.length > 1;
    if (!fromProgram || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    history.back();
  });
</script>
