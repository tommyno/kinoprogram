---
import { Font } from 'astro:assets';
import '@styles/global.css';
import { BUILD_ID } from '@lib/build.ts';
import styles from './Base.module.css';

type Props = {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Added to the page's <main>. */
  class?: string;
};

const SITE_NAME = 'Kinoprogram for Oslo';

const {
  title,
  description = 'Hva går på kino i Oslo? Alle filmene og tidene fra alle kinoene i byen, samlet på én side.',
  noindex = false,
  class: className,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-inter" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Kinoprogram" />
    <meta name="build" content={BUILD_ID} />

    <!-- Inline in the head, so it is listening before the page first renders -->
    <script is:inline>
      // Film pages nudge in from the right and back out the same way; other navigations cross-fade
      const onFilmPage = location.pathname.startsWith('/film/');
      addEventListener('pageswap', (event) => {
        if (event.viewTransition && onFilmPage) sessionStorage.setItem('from-film', '1');
      });
      addEventListener('pagereveal', (event) => {
        const fromFilm = sessionStorage.getItem('from-film');
        sessionStorage.removeItem('from-film');
        if (!event.viewTransition) return;
        if (onFilmPage) event.viewTransition.types.add('forward');
        else if (fromFilm) event.viewTransition.types.add('back');
      });
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main class:list={[styles.page, className]}>
      <slot />
    </main>
  </body>
</html>

<script>
  const build = document.querySelector<HTMLMetaElement>('meta[name="build"]')?.content;

  // An installed app resumes without reloading; when it comes back into view, load the latest build if there is one
  document.addEventListener('visibilitychange', async () => {
    if (document.visibilityState !== 'visible') return;
    try {
      const response = await fetch('/version.txt', { cache: 'no-store' });
      if (response.ok && (await response.text()) !== build) location.reload();
    } catch {}
  });
</script>
