---
import Base from '@layouts/Base.astro';
import Footer from '@components/Footer/Footer.astro';
import { CINEMAS, cinemaPath } from '@lib/cinemas.ts';
import { collator } from '@lib/program.ts';
import { SOURCES } from '@lib/sources/index.ts';
import styles from './AboutPage.module.css';

const cinemas = CINEMAS.map((c) => c.name).sort((a, b) => collator.compare(a, b));

// "Filmweb, Cinemateket og Deichman", each name a link
const names = new Intl.ListFormat('nb', { type: 'conjunction' });
let i = 0;
const sources = names.formatToParts(SOURCES.map((s) => s.name)).map((part) => (part.type === 'element' ? SOURCES[i++] : part.value));
---

<Base title="Om siden – Kinoprogram for Oslo" description="Hvor programmet, ratingene og trailerne på Kinoprogram for Oslo kommer fra.">
  <a href="/" class={styles.back}>← Kinoprogram for Oslo</a>

  <article class={styles.about}>
    <h1 class={styles.title}>Om siden</h1>
    <p>Alle kinoer og filmer i Oslo samlet på én side.</p>

    <h2 class={styles.heading}>Kinoene</h2>
    <ul class={styles.cinemas}>
      {cinemas.map((name) => <li><a href={cinemaPath(name)}>{name}</a></li>)}
    </ul>

    <h2 class={styles.heading}>Hvor dataene kommer fra</h2>
    <ul class={styles.list}>
      <li>Programdata hentes fra åpne kilder på {sources.map((part) => (typeof part === 'string' ? part : <a href={part.homepage}>{part.name}</a>))}.</li>
      <li>
        Ratinger, trailere, regi, skuespillere og noen plakater hentes fra <a href="https://www.themoviedb.org">TMDB</a>.
        <!-- TMDB's terms ask for their logo, unchanged and smaller than ours, and this notice -->
        <span class={styles.credit}>
          <a href="https://www.themoviedb.org" class={styles.tmdb}>
            <img src="/tmdb.svg" width="85" height="11" alt="TMDB" />
          </a>
          Denne siden bruker TMDB og TMDB-API-ene, men er ikke godkjent eller sertifisert av TMDB.
        </span>
      </li>
    </ul>

    <h2 class={styles.heading}>Kildekode</h2>
    <p>Koden ligger åpent på <a href="https://github.com/tommyno/kinoprogram">GitHub</a>.</p>
  </article>

  <Footer />
</Base>
