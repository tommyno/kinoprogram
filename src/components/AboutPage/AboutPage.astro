---
import Base from '@layouts/Base.astro';
import Footer from '@components/Footer/Footer.astro';
import { CINEMAS, cinemaPath } from '@lib/cinemas.ts';
import { listParts } from '@lib/program.ts';
import { SOURCES } from '@lib/sources/index.ts';
import styles from './AboutPage.module.css';

// "Filmweb, Cinemateket og Deichman", each name a link
const sources = listParts(SOURCES);
// Side by side under "Kino" and "Filmklubb og annet"
const cinemas = CINEMAS.filter((c) => !c.club);
const clubs = CINEMAS.filter((c) => c.club);
---

<Base
  title="Om nettstedet – Kinoprogram for Oslo"
  description="Programmet til alle kinoene og filmklubbene i Oslo, samlet på ett sted og sortert dag for dag."
>
  <a href="/" class={styles.back}>← Kinoprogram for Oslo</a>

  <article class={styles.about}>
    <header class={styles.header}>
      <h1 class={styles.title}>Om Kinoprogram for Oslo</h1>
      <p class={styles.lede}>Programmet til alle kinoene og filmklubbene i Oslo, samlet på ett sted og sortert dag for dag.</p>
    </header>

    <div class={styles.prose}>
      <p>
        Kinoprogram.net er et rent idealistisk prosjekt laget av filmentusiaster for andre filmentusiaster. Film er best på
        kino, og målet er å få frem alt det som vises av filmer i Oslo.
      </p>
    </div>

    <div class={styles.columns}>
      {
        [
          { heading: 'Kino', list: cinemas },
          { heading: 'Filmklubb og annet', list: clubs },
        ].map(({ heading, list }) => (
          <section class={styles.section}>
            <h2 class={styles.heading}>{heading}</h2>
            <ul class={styles.names}>
              {list.map(({ name }) => (
                <li>
                  <a href={cinemaPath(name)}>{name}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <section class={styles.section}>
      <h2 class={styles.heading}>Kontakt</h2>
      <div class={styles.prose}>
        <p>Har du tips om flere visningssteder i Oslo? Send en e-post til <a href="mailto:hei@kinoprogram.net">hei@kinoprogram.net</a></p>
      </div>
    </section>

    <section class={styles.section}>
      <h2 class={styles.heading}>Kilder og kreditering</h2>
      <p class={styles.small}>
        Programmet hentes fra {sources.map((part) => (typeof part === 'string' ? part : <a href={part.homepage} rel="noreferrer">{part.name}</a>))}.
      </p>
      <p class={styles.small}>Kinoprogram.net har ingen tilknytning til kinoene, filmklubbene eller kildene programmet hentes fra.</p>
      <!-- TMDB's terms ask for their logo, unchanged and smaller than ours, and this notice -->
      <p class={styles.credit}>
        <a href="https://www.themoviedb.org" class={styles.tmdb} rel="noreferrer">
          <img src="/tmdb.svg" width="85" height="11" alt="TMDB" />
        </a>
        Dette nettstedet bruker TMDB og TMDB-API-ene, men er ikke godkjent eller sertifisert av TMDB.
      </p>
    </section>
  </article>

  <Footer />
</Base>
