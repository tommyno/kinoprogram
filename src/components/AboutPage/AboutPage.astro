---
import Base from '@layouts/Base.astro';
import Footer from '@components/Footer/Footer.astro';
import { CINEMAS, cinemaPath } from '@lib/cinemas.ts';
import { listParts } from '@lib/program.ts';
import { SOURCES } from '@lib/sources/index.ts';
import styles from './AboutPage.module.css';

// "Filmweb, Cinemateket og Deichman", each name a link
const sources = listParts(SOURCES);
---

<Base title="Om nettstedet – Kinoprogram for Oslo" description="Alle kinoer, filmklubber og filmer i Oslo på ett sted.">
  <a href="/" class={styles.back}>← Kinoprogram for Oslo</a>

  <article class={styles.about}>
    <h1 class={styles.title}>Om nettstedet</h1>
    <p>Alle kinoer, filmklubber og filmer i Oslo på ett sted.</p>
    <p>
      Kinoprogram.net er et rent idealistisk prosjekt laget av filmentusiaster for andre filmentusiaster. Film er best på
      kino, og målet er å få frem alt det som vises av filmer i Oslo.
    </p>

    <h2 class={styles.heading}>Kino og filmklubb</h2>
    <p>{CINEMAS.map(({ name }, i) => <>{i > 0 && ', '}<a href={cinemaPath(name)}>{name}</a></>)}</p>

    <h2 class={styles.heading}>Datakilder</h2>
    <p>Programmet hentes fra {sources.map((part) => (typeof part === 'string' ? part : <a href={part.homepage}>{part.name}</a>))}.</p>
    <p>Ratinger, trailere, regi, skuespillere og noen plakater hentes fra <a href="https://www.themoviedb.org">TMDB</a>.</p>
    <!-- TMDB's terms ask for their logo, unchanged and smaller than ours, and this notice -->
    <p class={styles.credit}>
      <a href="https://www.themoviedb.org" class={styles.tmdb}>
        <img src="/tmdb.svg" width="85" height="11" alt="TMDB" />
      </a>
      Dette nettstedet bruker TMDB og TMDB-API-ene, men er ikke godkjent eller sertifisert av TMDB.
    </p>

    <h2 class={styles.heading}>Kildekode</h2>
    <p>Koden ligger åpent på <a href="https://github.com/tommyno/kinoprogram">GitHub</a>.</p>

    <h2 class={styles.heading}>Kontakt</h2>
    <p>
      Spørsmål eller tips om flere filmklubber eller andre visningssteder i Oslo? Si fra til <a href="mailto:hei@kinoprogram.net">hei@kinoprogram.net</a>
    </p>
  </article>

  <Footer />
</Base>
