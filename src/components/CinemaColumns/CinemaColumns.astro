---
import { cinemaPath } from '@lib/cinemas.ts';
import { collator, showingPath, type Film, type Showing } from '@lib/program.ts';
import { formatShortDay } from '@lib/time.ts';
import ShowingLink from '@components/ShowingLink/ShowingLink.astro';
import styles from './CinemaColumns.module.css';

type Props = {
  films: Record<string, Film>;
  showings: Showing[];
  /** The cinemas with nothing on this day and their next day with showings, so the ones that rarely show films are not lost. */
  later: { cinema: string; day: string }[];
};

const { films, showings, later } = Astro.props;
const cinemas = [...Map.groupBy(showings, (s) => s.cinema)].sort(([a], [b]) => collator.compare(a, b));
---

<div class={styles.columns}>
  {
    cinemas.map(([cinema, list], index) => (
      <section class={styles.cinema} data-stagger style={`--i: ${index}`}>
        <h2 class={styles.name}>
          <a href={cinemaPath(cinema)} class={styles.nameLink}>
            {cinema}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </h2>
        {list.map((s) => (
          <ShowingLink showing={s} text={[s.time, films[s.filmId].title, s.screen]} context={s.cinema} href={showingPath(films[s.filmId], s)} class={styles.row}>
            <span class={styles.time}>{s.time}</span>{' '}
            <span class={styles.title}>{films[s.filmId].title}</span>{' '}
            <span class={styles.screen}>{s.screen}</span>
          </ShowingLink>
        ))}
      </section>
    ))
  }
  {
    later.length > 0 && (
      <section class={styles.cinema} data-stagger style={`--i: ${cinemas.length}`}>
        <h2 class={styles.laterHeading}>Ingen visninger denne dagen</h2>
        {later.map(({ cinema, day }) => (
          <a href={cinemaPath(cinema)} class={styles.laterRow}>
            <span class={styles.title}>{cinema}</span>
            <span class={styles.screen}>{formatShortDay(day)}</span>
          </a>
        ))}
      </section>
    )
  }
</div>
