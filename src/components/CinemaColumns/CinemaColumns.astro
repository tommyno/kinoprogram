---
import { collator, type Film, type Showing } from '@lib/program.ts';
import { groupBy } from '@lib/groupBy.ts';
import ShowingLink from '@components/ShowingLink/ShowingLink.astro';
import styles from './CinemaColumns.module.css';

type Props = {
  films: Record<string, Film>;
  showings: Showing[];
};

const { films, showings } = Astro.props;
const cinemas = groupBy(showings, (s) => s.cinema).sort(([a], [b]) => collator.compare(a, b));
---

<div class={styles.columns}>
  {
    cinemas.map(([cinema, list], index) => (
      <section class={styles.cinema} data-stagger style={`--i: ${index}`}>
        <h2 class={styles.name}>{cinema}</h2>
        {list.map((s) => (
          <ShowingLink showing={s} title={films[s.filmId].title} class={styles.row}>
            <span class={styles.time}>{s.time}</span>
            <span class={styles.title}>{films[s.filmId].title}</span>
            <span class={styles.screen}>{s.screen}</span>
          </ShowingLink>
        ))}
      </section>
    ))
  }
</div>
