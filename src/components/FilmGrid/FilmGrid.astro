---
import { collator, type Film, type Showing } from '../../lib/program.ts';
import { formatDuration } from '../../lib/time.ts';
import { groupBy } from '../../lib/groupBy.ts';
import ShowingLink from '../ShowingLink/ShowingLink.astro';
import styles from './FilmGrid.module.css';

// Rendered collapsed to the first few times; the Program script moves that to the next few as showings start
const COLLAPSED_COUNT = 3;

type Props = {
  films: Record<string, Film>;
  showings: Showing[];
};

const { films, showings } = Astro.props;
const groups = groupBy(showings, (s) => s.filmId).sort(([a], [b]) => collator.compare(films[a].title, films[b].title));
---

<section aria-label="Filmer" class={styles.grid} data-collapsed-count={COLLAPSED_COUNT}>
  {
    groups.map(([filmId, list]) => {
      const film = films[filmId];
      const meta = [formatDuration(film.minutes), film.ageRating].filter(Boolean).join(' · ');
      const more = list.length - COLLAPSED_COUNT;
      return (
        <article class={styles.card} data-card>
          <a href={film.pageUrl} title="Mer om filmen" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            {film.posterUrl ? (
              <img
                class={styles.poster}
                src={film.posterUrl}
                srcset={film.posterSrcSet}
                sizes="(min-width: 1000px) 200px, 45vw"
                width="400"
                height="600"
                loading="lazy"
                alt=""
              />
            ) : (
              <div class={`${styles.poster} ${styles.placeholder}`}>
                <svg viewBox="0 0 100 150" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 0L100 150M100 0L0 150" vector-effect="non-scaling-stroke" />
                </svg>
              </div>
            )}
          </a>
          <div class={styles.heading}>
            <h2 class={styles.title}>
              <a href={film.pageUrl} title="Mer om filmen" target="_blank" rel="noopener">
                {film.title}
              </a>
            </h2>
            {meta && <p class={styles.meta}>{meta}</p>}
          </div>

          <div class={styles.times}>
            {list.map((s, i) => (
              <ShowingLink showing={s} title={film.title} class={styles.row} hidden={i >= COLLAPSED_COUNT}>
                <span class={styles.time}>{s.time}</span>
                <span class={styles.where}>{s.cinema}</span>
              </ShowingLink>
            ))}
          </div>

          <button type="button" class={styles.more} aria-expanded="false" hidden={more <= 0} data-more>
            {`+ ${more} ${more === 1 ? 'tid' : 'tider'} til`}
          </button>
        </article>
      );
    })
  }
</section>
