---
// A film's poster, or a crossed-out box when the source has none. Sized by its parent
import type { Film } from '@lib/program.ts';
import styles from './Poster.module.css';

type Props = {
  film: Film;
  sizes: string;
  /** Larger versions than the film's own srcset, where the page needs them. */
  srcset?: string;
  /** Loads at once and first, for posters in view when the page opens. */
  eager?: boolean;
};

const { film, sizes, srcset = film.posterSrcSet, eager = false } = Astro.props;
---

{
  film.posterUrl ? (
    <img class={styles.poster} src={film.posterUrl} srcset={srcset} sizes={sizes} width="400" height="600" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} alt="" />
  ) : (
    <div class={`${styles.poster} ${styles.placeholder}`}>
      <svg viewBox="0 0 100 150" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 0L100 150M100 0L0 150" vector-effect="non-scaling-stroke" />
      </svg>
    </div>
  )
}
