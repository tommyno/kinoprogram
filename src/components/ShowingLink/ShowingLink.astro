---
// A showing's link, to its ticket sale unless given another href. markPast in time.ts marks it once the showing has started
import type { Showing } from '@lib/program.ts';

type Props = {
  showing: Showing;
  /** The link's visible text in order. The label starts with it, so voice control finds the link by what it says. */
  text: string[];
  /** What the link leaves out, such as the film or the cinema; added after the visible text. */
  context?: string;
  class: string;
  hidden?: boolean;
  /** Where the link goes instead of the ticket sale, such as the film page (see showingPath). */
  href?: string;
  /** On the film page: the showing's name, which a showingPath link marks (see showingAnchor). */
  anchor?: string;
};

const { showing, text, context, class: className, hidden, href, anchor } = Astro.props;
const label = [text.filter(Boolean).join(' '), context].filter(Boolean).join(', ');
const toTickets = !href;
---

<a
  href={href ?? showing.bookingUrl}
  title={toTickets ? 'Kjøp billett' : 'Se alle visninger'}
  target={toTickets ? '_blank' : undefined}
  rel={toTickets ? 'noreferrer' : undefined}
  aria-label={label}
  data-day={showing.day}
  data-minutes={showing.minutes}
  data-showing={anchor}
  class={className}
  hidden={hidden}
>
  <slot />
</a>
