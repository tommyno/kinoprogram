---
// A showing's ticket link. markPast in time.ts marks it once the showing has started
import type { Showing } from '@lib/program.ts';

type Props = {
  showing: Showing;
  title: string;
  class: string;
  hidden?: boolean;
};

const { showing, title, class: className, hidden } = Astro.props;
---

<a
  href={showing.bookingUrl}
  title="Kjøp billett"
  target="_blank"
  rel="noopener"
  aria-label={`${title}, ${showing.time}, ${showing.cinema}`}
  data-day={showing.day}
  data-minutes={showing.minutes}
  class={className}
  hidden={hidden}
>
  <slot />
</a>
