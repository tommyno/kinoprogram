---
import Base from '@layouts/Base.astro';
import Footer from '@components/Footer/Footer.astro';
import Poster from '@components/Poster/Poster.astro';
import ShowingLink from '@components/ShowingLink/ShowingLink.astro';
import { filmDays, filmMeta } from '@lib/program.ts';
import { getProgram } from '@lib/source.ts';
import { dayLabel, formatDay, programNow } from '@lib/time.ts';
import styles from './FilmPage.module.css';

type Props = {
  filmId: string;
};

const { filmId } = Astro.props;
const program = await getProgram();
const today = programNow().day;
const film = program.films[filmId];
const days = filmDays(program, filmId, today);
const meta = filmMeta(film);
// pageUrl is the film's page at Filmweb, or at Cinemateket for its own screenings
const sourceName = new URL(film.pageUrl).hostname.endsWith('cinemateket.no') ? 'Cinemateket' : 'Filmweb';
// "7,7"
const rating = film.rating?.value.toLocaleString('nb-NO', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

<Base title={`${film.title} – Kinoprogram for Oslo`} description={`Alle visningene av ${film.title} på kino i Oslo, dag for dag.`}>
  <a href="/" class={styles.back} data-back>← Kinoprogram for Oslo</a>

  <header class={styles.header}>
    {
      film.posterLarge ? (
        <button
          type="button"
          class={styles.poster}
          style={`--poster-width: ${film.posterLarge.width}px`}
          aria-expanded="false"
          aria-label="Vis plakaten stor"
          data-poster
        >
          <Poster film={film} srcset={film.posterLarge.srcSet} sizes="(min-width: 700px) 160px, 104px" eager />
        </button>
      ) : (
        <div class={styles.poster} data-poster>
          <Poster film={film} sizes="(min-width: 700px) 160px, 104px" eager />
        </div>
      )
    }
    <div class={styles.heading} data-heading>
      <h1 class={styles.title}>{film.title}</h1>
      {meta && <p class={styles.meta}>{meta}</p>}
      {film.synopsis && <p class={styles.synopsis} data-synopsis>{film.synopsis}</p>}
      <div class={styles.links}>
        <a href={film.pageUrl} class={styles.source} target="_blank" rel="noopener">
          {sourceName}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"></path>
          </svg>
        </a>
        {
          film.rating && (
            <a href={film.rating.url} class={styles.source} target="_blank" rel="noopener" aria-label={`TMDB ${rating} av 10, ${film.rating.votes} stemmer`}>
              TMDB {rating}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"></path>
              </svg>
            </a>
          )
        }
      </div>
      {
        film.trailer && (
          <button type="button" class={styles.trailerButton} aria-expanded="false" aria-controls="trailer" data-trailer-button={film.trailer}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" aria-hidden="true" class={styles.play}>
              <path d="M7 4.5v15l12-7.5z"></path>
            </svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" class={styles.close}>
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
            <span data-label>Se trailer</span>
          </button>
        )
      }
    </div>
  </header>

  {film.trailer && <div id="trailer" class={styles.trailer} hidden data-trailer></div>}

  <div>
    {
      days.map(([day, list], index) => {
        const label = dayLabel(day, today);
        return (
          <section class={styles.day} data-stagger style={`--i: ${index}`} data-film-day={day}>
            <h2 class={styles.dayHeading}>
              <span class={styles.dayLabel} data-day-label>{label}</span>
              <span class={styles.date} hidden={label === formatDay(day)} data-date>{formatDay(day)}</span>
            </h2>
            <div class={styles.times}>
              {list.map((s) => (
                <ShowingLink showing={s} text={[s.time, s.cinema, s.screen]} context={film.title} class={styles.row}>
                  <span class={styles.time}>{s.time}</span>{' '}
                  <span class={styles.where}>{s.cinema}</span>{' '}
                  <span class={styles.screen}>{s.screen}</span>
                </ShowingLink>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>

  <Footer />
</Base>

<script>
  import { dayLabel, formatDay, markPast, programNow } from '@lib/time.ts';

  // The days are labelled at build time; in case Oslo has passed midnight since, drop the days that are over and label the rest again
  const today = programNow().day;
  for (const section of document.querySelectorAll<HTMLElement>('[data-film-day]')) {
    const day = section.dataset.filmDay!;
    if (day < today) {
      section.remove();
      continue;
    }
    const label = dayLabel(day, today);
    section.querySelector('[data-day-label]')!.textContent = label;
    section.querySelector<HTMLElement>('[data-date]')!.hidden = label === formatDay(day);
  }

  // Started showings grey out as the clock passes them, as in the program
  const links = [...document.querySelectorAll<HTMLElement>('[data-minutes]')];
  markPast(links);
  setInterval(() => markPast(links), 60_000);

  // Coming from the program, go back in history instead, so it opens at the same date, sort and scroll position
  const back = document.querySelector<HTMLAnchorElement>('[data-back]')!;
  back.addEventListener('click', (event) => {
    const fromProgram = document.referrer.startsWith(location.origin) && history.length > 1;
    if (!fromProgram || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    history.back();
  });

  // A click opens the poster to the page width, or its own width if that is smaller, and closes it again
  const poster = document.querySelector<HTMLElement>('button[data-poster]');
  if (poster) {
    const image = poster.querySelector('img')!;
    const smallSizes = image.sizes;
    poster.addEventListener('click', () => {
      const expanded = poster.toggleAttribute('data-expanded');
      poster.setAttribute('aria-expanded', String(expanded));
      // The browser then picks the version that is sharp at the new width
      if (expanded) image.sizes = `${poster.offsetWidth}px`;
      else image.sizes = smallSizes;
    });
  }

  // Nothing loads from YouTube until the visitor asks for the trailer; closing it removes the player, which stops it
  const trailerButton = document.querySelector<HTMLButtonElement>('[data-trailer-button]');
  if (trailerButton) {
    const player = document.querySelector<HTMLElement>('[data-trailer]')!;
    trailerButton.addEventListener('click', () => {
      const open = trailerButton.getAttribute('aria-expanded') !== 'true';
      trailerButton.setAttribute('aria-expanded', String(open));
      trailerButton.querySelector('[data-label]')!.textContent = open ? 'Lukk trailer' : 'Se trailer';
      player.replaceChildren();
      player.hidden = !open;
      if (!open) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${trailerButton.dataset.trailerButton}?autoplay=1`;
      iframe.title = `Trailer: ${document.querySelector('h1')!.textContent}`;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      // YouTube refuses to play embeds that don't say which site they are on (error 153)
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      player.append(iframe);
    });
  }

  const synopsis = document.querySelector<HTMLElement>('[data-synopsis]');

  if (synopsis) {
    const poster = document.querySelector<HTMLElement>('[data-poster]')!;
    const heading = document.querySelector<HTMLElement>('[data-heading]')!;
    let expanded = false;

    /** Cuts the synopsis off so the text column is no taller than the poster; a click opens and closes it. */
    const fitSynopsis = () => {
      synopsis.style.maxHeight = '';
      const overflow = heading.offsetHeight - poster.offsetHeight;
      const clamped = !expanded && overflow > 0;
      synopsis.toggleAttribute('data-clamped', clamped);
      if (clamped) {
        // At least two lines, so there is something to fade
        const minimum = 2 * parseFloat(getComputedStyle(synopsis).lineHeight);
        synopsis.style.maxHeight = `${Math.max(synopsis.offsetHeight - overflow, minimum)}px`;
      }
      // Opens and closes from the keyboard too while it is too long for the poster
      if (overflow > 0) {
        synopsis.tabIndex = 0;
        synopsis.setAttribute('role', 'button');
        synopsis.setAttribute('aria-expanded', String(expanded));
      } else {
        synopsis.removeAttribute('tabindex');
        synopsis.removeAttribute('role');
        synopsis.removeAttribute('aria-expanded');
      }
    };

    const toggleSynopsis = () => {
      if (!synopsis.hasAttribute('role')) return;
      expanded = !expanded;
      fitSynopsis();
    };

    synopsis.addEventListener('click', toggleSynopsis);
    synopsis.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      toggleSynopsis();
    });

    // Line breaks change with the viewport and once the font loads
    new ResizeObserver(fitSynopsis).observe(heading.parentElement!);
    document.fonts.ready.then(fitSynopsis);
  }
</script>
