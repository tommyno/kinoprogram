---
import styles from './Header.module.css';

type Props = {
  /** Left out on the search page, which covers every day. */
  picker?: {
    day: string;
    /** "i dag", "i morgen" or the date written out. */
    label: string;
    today: string;
    lastDay: string;
  };
};

const { picker } = Astro.props;
---

<header>
  <h1 class={styles.title}>
    Kinoprogram for Oslo{picker && ' '}
    {
      picker && (
        <span class={styles.picker}>
          <button type="button" class={styles.button} aria-label={`${picker.label}, velg dato`} data-date-button>
            <span>{picker.label}</span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          {/* Laid over the button for pointers; keyboards use the button, as the input's own fields would change the date on every arrow key */}
          <input
            class={styles.input}
            type="date"
            tabindex="-1"
            aria-hidden="true"
            value={picker.day}
            min={picker.today}
            max={picker.lastDay}
            data-today={picker.today}
            data-date-picker
          />
        </span>
      )
    }
  </h1>
</header>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-date-picker]');

  // Desktop browsers only open the calendar from its icon; open it from anywhere on the label
  function openPicker() {
    try {
      input?.showPicker();
    } catch {}
  }

  input?.addEventListener('click', openPicker);
  document.querySelector('[data-date-button]')?.addEventListener('click', openPicker);

  input?.addEventListener('change', () => {
    if (!input.value) return;
    const path = input.value === input.dataset.today ? '/' : `/${input.value}`;
    location.href = path + location.search;
  });
</script>
