---
import Base from '../../layouts/Base.astro';
import Footer from '../Footer/Footer.astro';
import Header from '../Header/Header.astro';
import Program from '../Program/Program.astro';
import { collator } from '../../lib/program.ts';
import { getProgram } from '../../lib/source.ts';
import { dayLabel, programNow } from '../../lib/time.ts';
import styles from './ProgramPage.module.css';

type Props = {
  day: string;
};

const { day } = Astro.props;
const program = await getProgram();
const today = programNow().day;
const lastDay = Object.keys(program.days).at(-1) ?? today;
const showings = program.days[day] ?? [];
const films = Object.fromEntries(showings.map((s) => [s.filmId, program.films[s.filmId]]));
const label = dayLabel(day, today);
const cinemas = [...new Set(Object.values(program.days).flat().map((s) => s.cinema))].sort(collator.compare);
const description = `Hva går på kino i Oslo ${label}? Alle filmene og tidene fra ${cinemas.slice(0, -1).join(', ')} og ${cinemas.at(-1)}.`;
---

<Base title={`Kinoprogram for Oslo ${label}`} description={description}>
  <main class={styles.page}>
    <Header day={day} label={label} today={today} lastDay={lastDay} />
    <Program day={day} films={films} showings={showings} />
    <button type="button" class={styles.top} data-to-top>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
      Til toppen
    </button>
    <Footer />
  </main>
</Base>

<script>
  // Scrolls without adding # to the URL; smoothness comes from scroll-behavior in global.css
  document.querySelector('[data-to-top]')?.addEventListener('click', () => window.scrollTo({ top: 0 }));
</script>
