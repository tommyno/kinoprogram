---
import Base from '@layouts/Base.astro';
import Footer from '@components/Footer/Footer.astro';
import Header from '@components/Header/Header.astro';
import Program from '@components/Program/Program.astro';
import { getProgram } from '@lib/source.ts';
import { dayLabel, programNow } from '@lib/time.ts';

type Props = {
  day: string;
};

const { day } = Astro.props;
const program = await getProgram();
const today = programNow().day;
const lastDay = Object.keys(program.days).at(-1) ?? today;
const showings = program.days[day] ?? [];
const films = Object.fromEntries(showings.map((s) => [s.filmId, program.films[s.filmId]]));
const label = dayLabel(day, today);
const description = `Hva går på kino i Oslo ${label}? Alle filmene og tidene fra alle kinoene i byen, samlet på én side.`;
---

<Base title={`Kinoprogram for Oslo ${label}`} description={description}>
  <Header picker={{ day, label, today, lastDay }} />
  <Program films={films} showings={showings} />
  <Footer />
</Base>
